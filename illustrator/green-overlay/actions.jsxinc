// Green Overlay: actions (included by green-overlay.jsx)
        destinationTree.onChange = function () {
            try {
                // ScriptUI can fire onChange while trees are rebuilt during load.
                if (loading || suppressObjectEvent > 0) return;
                if (destinationTree.selection !== null) {
                    statusText.text =
                        "作成先: " + destinationTree.selection.text;
                }
                updateRunState();
            } catch (e) {
                showError(e);
            }
        };

        function updateLayerTargetButton() {
            layerTargetButton.enabled = !loading && activeLayerEntry !== null;
            layerTargetButton.text = activeLayerEntry && picked[activeLayerEntry.id]
                ? "レイヤー対象を解除" : "レイヤー全体を対象にする";
        }

        layerTargetButton.onClick = function () {
            if (loading || !activeLayerEntry) return;
            var documentState = paletteDocumentState();
            if (documentState < 0) return;
            var entry = activeLayerEntry;
            try {
                var turnOn = !picked[entry.id];
                setPicked(entry, turnOn);
                updateCountAndInfo(entry);
                if (turnOn && documentState > 0) requestCanvasFollow(entry);
                statusText.text = turnOn
                    ? "レイヤーを対象にしました。範囲は実行時に取得します。"
                    : "レイヤー対象を解除しました。";
            } catch (e) { showError(e); }
            finally { updateLayerTargetButton(); }
        };

        function handleObjectListEvent() {
            try {
                var row, entry, i;

                // Tree rebuild calls w.update(); host selection must not run pick/pan there.
                if (loading || suppressObjectEvent > 0 || inObjectListHandler) return;
                inObjectListHandler = true;

                row = objectList.selection;
                if (row === null) {
                    inObjectListHandler = false;
                    return;
                }

                entry = row._entry;
                if (!entry) {
                    inObjectListHandler = false;
                    return;
                }

                // A layer row still belongs to native disclosure. The separate
                // toolbar button chooses the layer without changing this tree.
                activeLayerEntry = entry.itemType === "Layer" ? entry : null;
                updateLayerTargetButton();
                if (activeLayerEntry) {
                    infoText.text = "レイヤー: " + entry.label +
                        "\n「レイヤー全体を対象にする」で範囲全体を選択できます。";
                }

                var documentState = (entry.descendantToggle || entry.selectable) ? paletteDocumentState() : 0;
                if (documentState < 0) {
                    inObjectListHandler = false;
                    return;
                }
                if (entry.descendantToggle) {
                    var parentEntry = entry.parentEntry;
                    var turnOn = descendantSelectionState(parentEntry) !== 2;
                    setDescendantsPicked(parentEntry, turnOn, documentState > 0);
                    updateCountAndInfo(null);
                    statusText.text = turnOn
                        ? "配下をすべて選択しました。"
                        : "配下をすべて解除しました。";
                    suppressObjectEvent++;
                    try { objectList.selection = null; } catch (_) {}
                    suppressObjectEvent--;
                    inObjectListHandler = false;
                    return;
                }

                if (entry.selectable) {
                    setPicked(entry, !picked[entry.id]);
                    updateCountAndInfo(entry);
                    if (documentState > 0) applyIllustratorSelection(entry);
                    if (picked[entry.id] && documentState > 0) requestCanvasFollow(entry);
                    suppressObjectEvent++;
                    try { objectList.selection = null; } catch (_) {}
                    suppressObjectEvent--;
                    inObjectListHandler = false;
                    return;
                }

                // Container disclosure is handled exclusively by the native TreeView.
                inObjectListHandler = false;
            } catch (e) {
                inObjectListHandler = false;
                showError(e);
            }
        }

        objectList.onClick = null;
        objectList.onChange = handleObjectListEvent;

        selectAllButton.onClick = function () {
            try {
                var documentState = paletteDocumentState();
                if (documentState < 0) return;
                for (var i = 0; i < objectEntries.length; i++) {
                    var entry = objectEntries[i];
                    if (entry.selectable) {
                        setPicked(entry, true);
                        if (documentState > 0) applyIllustratorSelection(entry);
                    }
                }
                updateCountAndInfo(null);
                statusText.text = "すべて選択しました。";
            } catch (e) {
                showError(e);
            }
        };

        clearButton.onClick = function () {
            try {
                var documentState = paletteDocumentState();
                if (documentState < 0) return;
                for (var i = 0; i < objectEntries.length; i++) setPicked(objectEntries[i], false);
                updateLayerTargetButton();
                if (documentState > 0) { try { doc.selection = null; } catch (_) {} }
                updateCountAndInfo(null);
                statusText.text = "すべて解除しました。";
            } catch (e) {
                showError(e);
            }
        };

        runButton.onClick = function () {
            try {
                if (paletteDocumentState() < 0) return;
                var destinationNode = destinationTree.selection;
                if (destinationNode === null) {
                    alert("作成先を選択してください。");
                    return;
                }

                var destination = destinationNode._entry;

                if (!destination || !destination.ref) {
                    alert("作成先を取得できません。");
                    return;
                }

                try {
                    if (destination.ref.locked) {
                        alert("作成先がロックされています。");
                        return;
                    }
                } catch (_) {}

                var settings = overlaySettings();
                if (!settings) {
                    alert("RGB は 0〜255、不透明度は 0〜100 の数値で入力してください。");
                    return;
                }

                var count = pickedCount;
                if (!count) {
                    alert("対象オブジェクトを選択してください。");
                    return;
                }

                if (!confirm(
                    count +
                    "件のオブジェクト上に矩形を作成します。\n" +
                    "RGB: " + settings.r + ", " + settings.g + ", " + settings.b +
                    " / 不透明度: " + settings.opacity + "%\n" +
                    "実行しますか？"
                )) {
                    return;
                }

                if (paletteDocumentState() < 0) return;
                sendBridgeTalk(buildExecuteScript(destination, settings));
                statusText.text = "作成を要求しました。";
            } catch (e) {
                showError(e);
            }
        };

        w.onResizing = w.onResize = function () {
            this.layout.resize();
        };

        w.onClose = function () {
            // ScriptUI may fire close while trees are rebuilt; reject that until ready.
            if (loading) {
                try { logEvent("ui.close", "ignored during load"); } catch (_) {}
                return false;
            }
            try {
                $.global.__greenOverlayDiagnostic = null;
                $.global.__greenOverlayDiagnosticOwner = null;
                $.global.__greenOverlayWindow = null;
            } catch (_) {}
            return true;
        };

